{
  "name": "@prabish01/nepali-date",
  "version": "0.1.1",
  "description": "Immutable Bikram Sambat dates, Nepal timezone conversion, formatting, fiscal years, holidays and tithi utilities.",
  "license": "(MIT AND Apache-2.0)",
  "author": {
    "name": "Prabish Dangi",
    "url": "https://www.linkedin.com/in/prabish-dangi-04a649211/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/calendar.json": "./data/calendar.json",
    "./data/holidays.json": "./data/holidays.json"
  },
  "files": [
    "dist",
    "data",
    "licenses",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "prepack": "npm run build && npm test",
    "check:types": "tsc -p tsconfig.json",
    "check:browser": "node scripts/check-browser.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run build && npm test && npm run check:types && npm run check:browser && npm run check:package"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "ad",
    "nepal",
    "calendar",
    "date",
    "fiscal-year",
    "tithi",
    "timezone"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabish01/nepali-date.git"
  },
  "bugs": {
    "url": "https://github.com/prabish01/nepali-date/issues"
  },
  "homepage": "https://github.com/prabish01/nepali-date#readme"
}
